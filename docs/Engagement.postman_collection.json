  "item": [
    {
      "name": "0. Auth — Login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"{{password}}\",\n  \"identifier\": \"{{identifier}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Login sebagai koordinator ronda atau officer. Script test otomatis menyimpan token ke variable collection."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var j = pm.response.json();",
              "if (j.data && j.data.token) { pm.collectionVariables.set('token', j.data.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
