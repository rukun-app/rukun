  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://rukun.p85.test",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "area_id",
      "value": "",
      "type": "string",
      "description": "UUID publik RT/RW"
    },
    {
      "key": "team_id",
      "value": "",
      "type": "string",
      "description": "UUID publik tim ronda"
    },
    {
      "key": "event_id",
      "value": "",
      "type": "string",
      "description": "UUID publik event"
    },
    {
      "key": "participant_id",
