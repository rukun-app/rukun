APP_NAME=CoreR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://core-r.p85.test:8443
FRONTEND_URL=https://core-r.p85.test:8443
API_DOCS_ENABLED=true
API_DOCS_TITLE="Core R API"
API_DOCS_VERSION=1.0.0
TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Jakarta

# Runtime settings fallback. Database overrides take precedence.
AUTH_REGISTRATION_ENABLED=false
AUTH_EMAIL_VERIFICATION_REQUIRED=true
AUTH_TOKEN_EXPIRATION_DAYS=30
AUTH_MAX_LOGIN_ATTEMPTS=5
FILES_MAX_UPLOAD_MB=10
FILES_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,text/plain
REALTIME_EVENT_RETENTION_DAYS=7
OPS_FAILED_JOB_RETENTION_HOURS=168
API_IDEMPOTENCY_TTL_HOURS=24

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Use LOG_CHANNEL=json for structured production logs on stderr.

DB_CONNECTION=core
CORE_DB_PREFIX=rcore_
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel_core
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_LIMITER=redis
# CACHE_PREFIX=

RATE_LIMIT_AUTH_REGISTER=5
RATE_LIMIT_AUTH_LOGIN=20
RATE_LIMIT_AUTH_RECOVERY=3
RATE_LIMIT_FILES_UPLOAD=20
RATE_LIMIT_EVENTS_POLL=120
RATE_LIMIT_NOTIFICATIONS_MUTATE=60
RATE_LIMIT_ADMIN_SENSITIVE=30
RATE_LIMIT_PAYMENT_WEBHOOKS=120

PAYMENT_GATEWAY=midtrans
MIDTRANS_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_PRODUCTION=false
MIDTRANS_TIMEOUT=10
# MIDTRANS_SNAP_URL=
# MIDTRANS_API_URL=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=core-r:
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_SESSION_DB=2

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=maildev
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Set BROADCAST_CONNECTION=reverb after providing unique credentials.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=core-r-reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=core-r.p85.test

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
